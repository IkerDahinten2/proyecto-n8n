    {
      "parameters": {
        "jsCode": "// Resume las solicitudes registradas en los últimos 7 días, agrupadas por estado.\nconst DIAS = 7;\nconst hoy = new Date();\nconst desde = new Date(hoy.getTime() - DIAS * 24 * 60 * 60 * 1000);\nconst formato = (fecha) => fecha.toISOString().slice(0, 10);\n\nconst filas = $input.all().map(item => item.json).filter(fila => fila.estado);\nconst semana = filas.filter(fila => {\n  const fecha = new Date(fila.fecha_registro || fila.fecha);\n  return !Number.isNaN(fecha.getTime()) && fecha >= desde && fecha <= hoy;\n});\n\nconst conteo = semana.reduce((acc, fila) => {\n  acc[fila.estado] = (acc[fila.estado] || 0) + 1;\n  return acc;\n}, {});\n\nconst mensaje = semana.length === 0\n  ? '📊 Reporte semanal: esta semana no hubo solicitudes de inasistencia.'\n  : [\n      '📊 Reporte semanal de inasistencias',\n      `Periodo: ${formato(desde)} a ${formato(hoy)}`,\n      `Total de solicitudes: ${semana.length}`,\n      '',\n      ...Object.entries(conteo).map(([estado, total]) => `• ${estado}: ${total}`)\n    ].join('\\n');\n\nreturn [{ json: { mensaje, total: semana.length, conteo } }];"
      },
