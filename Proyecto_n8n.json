    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normaliza la respuesta del LLM a { veredicto, nivel_confianza, razon }.\n// Si algo falla devuelve un estado seguro (\"Dudoso\", 0) que termina en revisión manual.\nconst VEREDICTOS = ['Aprobado', 'Rechazado', 'Dudoso'];\nconst estadoSeguro = (razon) => ({ veredicto: 'Dudoso', nivel_confianza: 0, razon });\n\nfunction normalizar(datos) {\n  const recibido = String(datos.veredicto || '').trim().toLowerCase();\n  const veredicto = VEREDICTOS.find(v => v.toLowerCase() === recibido) || 'Dudoso';\n  let confianza = Number.parseFloat(datos.nivel_confianza);\n  if (!Number.isFinite(confianza)) confianza = 0;\n  confianza = Math.min(100, Math.max(0, confianza));\n  const razon = String(datos.razon || 'Sin detalles').trim().slice(0, 500);\n  return { veredicto, nivel_confianza: confianza, razon };\n}\n\nconst salida = $input.item.json.text ?? $input.item.json.output ?? '';\nif (salida && typeof salida === 'object') return normalizar(salida);\n\n// Quita bloques de código markdown que algunos LLM agregan\nconst texto = String(salida).replace(/```(?:json)?/gi, '').trim();\nif (!texto) return estadoSeguro('La IA no generó una respuesta procesable.');\n\nconst inicio = texto.indexOf('{');\nconst fin = texto.lastIndexOf('}');\nif (inicio === -1 || fin <= inicio) return estadoSeguro('La respuesta de la IA no contiene un JSON válido.');\n\ntry {\n  return normalizar(JSON.parse(texto.slice(inicio, fin + 1)));\n} catch (error) {\n  return estadoSeguro('Error de formato en la respuesta de la IA.');\n}"
      },
